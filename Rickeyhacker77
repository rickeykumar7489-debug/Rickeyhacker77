
import os
import time
import random
import shutil

GREEN = "\033[92m"
CYAN = "\033[96m"
WHITE = "\033[97m"
RESET = "\033[0m"

def clear():
    os.system("clear")

def banner():
    print(GREEN + r"""
 ____  _      _              _   _            _
|  _ \(_) ___| | _____ _   _| | | | __ _  ___| | _____ _ __
| |_) | |/ __| |/ / _ \ | | | |_| |/ _` |/ __| |/ / _ \ '__|
|  _ <| | (__|   <  __/ |_| |  _  | (_| | (__|   <  __/ |
|_| \_\_|\___|_|\_\___|\__, |_| |_|\__,_|\___|_|\_\___|_|
                       |___/
""" + RESET)

    print(CYAN + "       ANDROID TERMINAL EXPERIENCE" + RESET)
    print(GREEN + "       STAY SAFE • STAY ETHICAL\n" + RESET)

def loading():
    messages = [
        "Initializing RickeyHacker...",
        "Loading Python Environment...",
        "Starting Visual Effects...",
        "System Status: READY"
    ]

    for msg in messages:
        print(GREEN + "[+] " + WHITE + msg + RESET)
        time.sleep(0.7)

def matrix():
    width = shutil.get_terminal_size().columns
    height = 20
    chars = "01ABCDEFGHIJKLMNOPQRSTUVWXYZ"

    try:
        while True:
            for _ in range(height):
                line = "".join(
                    random.choice(chars) for _ in range(width)
                )
                print(GREEN + line + RESET)
                time.sleep(0.04)

            time.sleep(0.1)

    except KeyboardInterrupt:
        print(RESET + "\nMatrix stopped.")

def main():
    clear()
    banner()
    loading()

    print("\n" + CYAN + "[1] Start Matrix Effect")
    print("[2] Show About")
    print("[3] Exit" + RESET)

    choice = input("\n" + GREEN + "RickeyHacker > " + RESET)

    if choice == "1":
        clear()
        banner()
        matrix()

    elif choice == "2":
        print(GREEN + "\nRickeyHacker Python Project")
        print("Educational Terminal Animation")
        print("Stay Safe, Stay Ethical!" + RESET)

    elif choice == "3":
        print(GREEN + "Goodbye!" + RESET)

    else:
        print("Invalid option!")

if __name__ == "__main__":
    main()
